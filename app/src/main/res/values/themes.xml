<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Splash color tokens ───────────────────────────────────── -->
    <!-- Matches the olive/forest green background of the app -->
    <color name="splash_bg">#1A2E0D</color>
    <!-- Branding color for the icon background circle on the splash -->
    <color name="splash_icon_bg">#556500</color>

    <!-- ── Android 12+ SplashScreen API theme ───────────────────── -->
    <!--
        This theme is set on the <activity> in AndroidManifest so the OS
        can render the splash BEFORE your first Compose frame.
        core-splashscreen 1.0.1 back-ports the behaviour to API 23+.
    -->
    <style name="Theme.Virasat.Splash" parent="Theme.SplashScreen">
        <!-- Full-screen background colour shown while the process cold-starts -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <!-- Vector icon displayed in the centre (replace with your logo) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <!-- Icon background tint (the circle behind the icon) -->
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_bg</item>
        <!-- How long to keep the splash on screen after the app is ready (ms, max 1000) -->
        <item name="windowSplashScreenAnimationDuration">400</item>
        <!-- Theme to switch to once installSplashScreen().setKeepOnScreenCondition returns false -->
        <item name="postSplashScreenTheme">@style/Theme.Virasat</item>
    </style>

    <!-- ── App runtime theme ─────────────────────────────────────── -->
    <style name="Theme.Virasat" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Match window background to the splash so there is NO colour jump
             between the OS splash and the first Compose frame. -->
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

</resources>
