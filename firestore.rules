rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Sites collection (public heritage data) ───────────────────────────
    match /sites/{siteId} {
      // Anyone can read site information (public data)
      allow read: if true;
      // ONLY admin can write — use Firebase Admin SDK or Cloud Functions for seeding
      // Clients CANNOT directly write to sites
      allow write: if false;
    }

    // ── Translations (shared Kannada translations, any authenticated user can read/write) ──
    match /translations/{siteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── User profiles and user-scoped data ───────────────────────────────
    match /users/{userId} {
      // Users can only read/write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ── Check-ins (persisted in Room DB + Firestore) ──────────────────
      match /checkins/{checkinId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Unlocked facts (QR scan rewards) ──────────────────────────────
      match /unlockedFacts/{factId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Bookmarked / saved sites ───────────────────────────────────────
      match /bookmarks/{siteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Deny all other paths ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
